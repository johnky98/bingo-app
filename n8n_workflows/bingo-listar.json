{
  "id": "bingo-listar-wf-0001",
  "name": "Bingo - Listar Registros (GET -> idTarjeta+nombre desde Data Table)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "bingo-listar",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "4c0d5e2b-0000-4000-8000-000000000001",
      "name": "Webhook Listar",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "bingo-listar-webhook"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "4jfby1bxzFbhu20T"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            { "keyName": "evento", "condition": "eq", "keyValue": "={{ $('Webhook Listar').item.json.query.evento }}" }
          ]
        },
        "returnAll": true
      },
      "id": "4c0d5e2b-0000-4000-8000-000000000002",
      "name": "Leer Data Table",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "// Filtro opcional por lote (tanda de tarjetas): si el query param 'lote'\n// viene vacío, se devuelven todos los registros del evento (compatibilidad\n// con llamadas viejas y con el panel de 'ver todo'). Si viene con valor,\n// solo se dejan pasar los registros de esa tanda específica, para que un\n// lote nuevo de tarjetas no muestre registros de una tanda/prueba anterior\n// que reutilizó el mismo número de tarjeta.\nconst loteFiltro = $('Webhook Listar').item.json.query.lote;\nif (!loteFiltro) return items;\nreturn items.filter(i => String(i.json.lote || '') === String(loteFiltro));"
      },
      "id": "4c0d5e2b-0000-4000-8000-000000000005",
      "name": "Filtrar por Lote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "return items.map(i => ({ json: { idTarjeta: i.json.idTarjeta, nombre: i.json.nombre } }));"
      },
      "id": "4c0d5e2b-0000-4000-8000-000000000003",
      "name": "Formatear Lista",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $input.all().map(item => item.json) }}",
        "options": {}
      },
      "id": "4c0d5e2b-0000-4000-8000-000000000004",
      "name": "Responder Listar",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Webhook Listar": { "main": [[{ "node": "Leer Data Table", "type": "main", "index": 0 }]] },
    "Leer Data Table": { "main": [[{ "node": "Filtrar por Lote", "type": "main", "index": 0 }]] },
    "Filtrar por Lote": { "main": [[{ "node": "Formatear Lista", "type": "main", "index": 0 }]] },
    "Formatear Lista": { "main": [[{ "node": "Responder Listar", "type": "main", "index": 0 }]] }
  },
  "active": true,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
