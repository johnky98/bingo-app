{
  "id": "bingo-exportar-wf-0001",
  "name": "Bingo - Exportar a Sheets (GET -> nueva hoja filtrada por evento)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "bingo-exportar",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "3b9f4c1a-0000-4000-8000-000000000001",
      "name": "Webhook Exportar",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "n1", "name": "eventoFiltro", "type": "string", "value": "={{ $json.query?.evento ?? \"\" }}" },
            { "id": "n2", "name": "nombreHoja", "type": "string", "value": "=Export - {{ $json.query?.evento ?? \"sin-evento\" }} - {{ $now.toFormat(\"yyyy-MM-dd_HHmm\") }}" }
          ]
        },
        "options": {}
      },
      "id": "3b9f4c1a-0000-4000-8000-000000000002",
      "name": "Preparar Nombre Hoja",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "create",
        "documentId": { "__rl": true, "mode": "id", "value": "12vm4vfqLUF4S2E4NC6nKdnFyo1Q4sHGxZM_tQR8G5t0" },
        "title": "={{ $json.nombreHoja }}",
        "options": {}
      },
      "id": "3b9f4c1a-0000-4000-8000-000000000003",
      "name": "Crear Hoja",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [680, 300]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": { "__rl": true, "mode": "id", "value": "4jfby1bxzFbhu20T" },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            { "keyName": "evento", "condition": "eq", "keyValue": "={{ $('Webhook Exportar').item.json.query.evento }}" }
          ]
        },
        "returnAll": true
      },
      "id": "3b9f4c1a-0000-4000-8000-000000000004",
      "name": "Leer Data Table",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "append",
        "documentId": { "__rl": true, "mode": "id", "value": "12vm4vfqLUF4S2E4NC6nKdnFyo1Q4sHGxZM_tQR8G5t0" },
        "sheetName": { "__rl": true, "mode": "name", "value": "={{ $('Preparar Nombre Hoja').item.json.nombreHoja }}" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "nombre": "={{ $json.nombre }}",
            "cedula": "={{ $json.cedula }}",
            "celular": "={{ $json.celular }}",
            "edad": "={{ $json.edad }}",
            "direccion": "={{ $json.direccion }}",
            "barrio": "={{ $json.barrio }}",
            "profesion": "={{ $json.profesion }}",
            "autorizacionDatos": "={{ $json.autorizacionDatos }}",
            "idTarjeta": "={{ $json.idTarjeta }}",
            "evento": "={{ $json.evento }}",
            "candidato": "={{ $json.candidato }}",
            "fecha": "={{ $json.fecha }}",
            "registradoEn": "={{ $json.registradoEn }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "nombre", "displayName": "nombre", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "cedula", "displayName": "cedula", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "celular", "displayName": "celular", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "edad", "displayName": "edad", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "direccion", "displayName": "direccion", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "barrio", "displayName": "barrio", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "profesion", "displayName": "profesion", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "autorizacionDatos", "displayName": "autorizacionDatos", "type": "boolean", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "idTarjeta", "displayName": "idTarjeta", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "evento", "displayName": "evento", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "candidato", "displayName": "candidato", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "fecha", "displayName": "fecha", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "registradoEn", "displayName": "registradoEn", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true }
          ]
        },
        "options": {}
      },
      "id": "3b9f4c1a-0000-4000-8000-000000000005",
      "name": "Escribir Filas",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"exportado\": true, \"hoja\": $('Preparar Nombre Hoja').item.json.nombreHoja, \"linkHoja\": \"https://docs.google.com/spreadsheets/d/12vm4vfqLUF4S2E4NC6nKdnFyo1Q4sHGxZM_tQR8G5t0/edit\" + ($('Crear Hoja').item.json.replies && $('Crear Hoja').item.json.replies[0] && $('Crear Hoja').item.json.replies[0].addSheet ? \"#gid=\" + $('Crear Hoja').item.json.replies[0].addSheet.properties.sheetId : \"\") } }}",
        "options": {}
      },
      "id": "3b9f4c1a-0000-4000-8000-000000000006",
      "name": "Responder Export",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1340, 300]
    }
  ],
  "connections": {
    "Webhook Exportar": { "main": [[{ "node": "Preparar Nombre Hoja", "type": "main", "index": 0 }]] },
    "Preparar Nombre Hoja": { "main": [[{ "node": "Crear Hoja", "type": "main", "index": 0 }]] },
    "Crear Hoja": { "main": [[{ "node": "Leer Data Table", "type": "main", "index": 0 }]] },
    "Leer Data Table": { "main": [[{ "node": "Escribir Filas", "type": "main", "index": 0 }]] },
    "Escribir Filas": { "main": [[{ "node": "Responder Export", "type": "main", "index": 0 }]] }
  },
  "active": true,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
